<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
             
    <!-- NOME DA UNIDADE DE PERSISTÊNCIA: MANTIDO COMO "ProjectCalcCorp" -->
    <persistence-unit name="ProjectCalcCorp" transaction-type="JTA">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        
        <!-- CORREÇÃO PRINCIPAL: Adicionada a referência ao Data Source do GlassFish -->
        <jta-data-source>jdbc/postgresDS</jta-data-source>
        
        <!-- Permite que o JPA reconheça automaticamente todas as classes com @Entity -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        
        <properties>
            <property name="eclipselink.logging.level" value="FINE"/>
        </properties>
    </persistence-unit>
</persistence>